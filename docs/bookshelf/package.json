{
  "name": "inkrail-bookshelf",
  "version": "0.1.0",
  "description": "AsciiDoc bookshelf workspace for the inkrail CLI design documentation.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "弥澄亮",
    "email": "t103ooooo@stu.mju.edu.cn",
    "url": "https://github.com/MichengLiang"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichengLiang/inkrail.git",
    "directory": "docs/bookshelf"
  },
  "bugs": {
    "url": "https://github.com/MichengLiang/inkrail/issues"
  },
  "homepage": "https://michengliang.github.io/inkrail/",
  "type": "module",
  "keywords": [
    "asciidoc",
    "asciidoctor",
    "documentation",
    "books",
    "multi-book",
    "inkrail",
    "cli",
    "rdf",
    "sparql",
    "github-pages",
    "static-site"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "build:adoc": "node scripts/build-adoc.mjs",
    "build:catalog": "asciidoctor catalog.adoc -D build/html",
    "build:books": "node scripts/build-books.mjs",
    "copy:assets": "node scripts/copy-assets.mjs",
    "enhance:html": "node scripts/add-home-links.mjs build/html",
    "write:index": "node scripts/write-root-index.mjs build/html",
    "check:html": "node scripts/check-html-local-resources.mjs build/html",
    "check:contract": "node scripts/check-workspace-contract.mjs",
    "check:samples": "node scripts/check-sample-contract.mjs",
    "check:all": "pnpm run check:contract && pnpm run check:samples",
    "build": "pnpm run build:adoc && pnpm run build:catalog && pnpm run build:books && pnpm run copy:assets && pnpm run enhance:html && pnpm run write:index && pnpm run check:html && pnpm run check:contract",
    "check": "pnpm run test && pnpm run build && pnpm run check:samples",
    "clean": "rm -rf build"
  },
  "devDependencies": {
    "@asciidoctor/reducer": "1.1.2",
    "asciidoctor": "2.2.9",
    "asciidoctor-kroki": "0.18.1"
  }
}
